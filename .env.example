# .env.example  -> copie para .env.local e preencha
#
# Gere valores com:  npm run gen:credentials -- "SuaSenha" seu.usuario "Seu Nome"
# (o comando imprime as versões LOCAL [$ escapado] e VERCEL [$ cru])
#
# ⚠️ REGRA DO $ (hash bcrypt):
#   • .env.local (LOCAL): $ ESCAPADO -> \$2b\$12\$...   (Next usa dotenv-expand)
#   • Vercel (painel):    $ CRU      ->  $2b$12$...

AUTH_SECRET=

# ── Múltiplos usuários (recomendado) — login por USUÁRIO + senha ──
# Lista JSON; item: {"username","name","passwordHash"}. LOCAL com \$ :
AUTH_USERS=[{"username":"admin","name":"Admin","passwordHash":"\$2b\$12\$..."}]

# ── Alternativa: usuário único ──
# AUTH_LOGIN_USER=admin
# AUTH_LOGIN_NAME=Admin
# AUTH_LOGIN_PASSWORD_HASH=\$2b\$12\$...

# ─────────────────────────────────────────────────────────────
# (OPCIONAL) Redis externo compartilhado para rate-limit de login e
# cache de rotas em produção serverless (Vercel c/ múltiplas instâncias).
# Sem estas variáveis, o app usa memória por processo (funciona, mas não
# é compartilhado entre instâncias). A integração Upstash da Vercel injeta
# ambas automaticamente. Doc: https://upstash.com/docs/redis/features/restapi
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
