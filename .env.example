# .env.example  -> copie para .env.local e preencha
#
# Login é via Supabase Auth (e-mail + senha, definida pelo próprio usuário).
# Para criar/revogar acesso de alguém, use o Supabase Dashboard
# (Authentication -> Users) ou:
#   node --env-file=.env.local scripts/create-supabase-user.mjs "email@empresa.com" "Nome"
# (a pessoa recebe um e-mail com link pra definir a senha — ninguém, nem
# quem roda o script, fica sabendo a senha dela)

# ─────────────────────────────────────────────────────────────
# (OPCIONAL) Redis externo compartilhado para rate-limit de login e
# cache de rotas em produção serverless (Vercel c/ múltiplas instâncias).
# Sem estas variáveis, o app usa memória por processo (funciona, mas não
# é compartilhado entre instâncias). A integração Upstash da Vercel injeta
# ambas automaticamente. Doc: https://upstash.com/docs/redis/features/restapi
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# ─────────────────────────────────────────────────────────────
# (OBRIGATÓRIO) Supabase — auth de usuários do app (login por e-mail/senha)
# E guarda as orgs Datadog salvas por usuário (múltiplas orgs, chaves
# cifradas em repouso).
# 1. Crie um projeto em https://supabase.com
# 2. Rode o SQL de scripts/supabase-schema.sql no SQL Editor do projeto
# 3. Project Settings -> API:
#    - URL + "anon"/"publishable" key (client-safe, usadas pelo browser E
#      pelo servidor para checar sessão) -> NEXT_PUBLIC_*
#    - "service_role" key (NUNCA client-safe, ignora RLS, só operações
#      administrativas server-only: CRUD de conexões, criar usuário) -> SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Chave(s) usada(s) pra cifrar API Key/App Key antes de gravar no Supabase.
# Versionado: CONNECTIONS_ENCRYPTION_KEYS é um mapa {"versão": "chave"} — dá
# pra ter mais de uma chave "ativa" ao mesmo tempo, então rotacionar a chave
# NÃO invalida os dados já salvos (cada linha do banco guarda em qual versão
# foi cifrada). CONNECTIONS_ENCRYPTION_KEY_VERSION diz qual versão do mapa é
# a atual (usada pra cifrar dados NOVOS).
#
# Gere uma chave nova (32 bytes) com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Como rotacionar (sem downtime):
#   1. Adicione a nova versão em CONNECTIONS_ENCRYPTION_KEYS SEM remover a antiga.
#   2. Troque CONNECTIONS_ENCRYPTION_KEY_VERSION pra a nova versão.
#   3. Quando quiser, rode `node --env-file=.env.local scripts/reencrypt-connections.mjs`
#      pra migrar as linhas antigas pra versão atual — só DEPOIS disso é seguro
#      remover a chave velha de CONNECTIONS_ENCRYPTION_KEYS (removê-la antes só
#      torna as conexões daquela versão temporariamente ilegíveis pro usuário
#      dono delas, não derruba a aplicação inteira).
CONNECTIONS_ENCRYPTION_KEYS={"1":""}
CONNECTIONS_ENCRYPTION_KEY_VERSION=1

# ─────────────────────────────────────────────────────────────
# (OPCIONAL) Sentry — captura de erro em produção (Error Boundaries em
# src/app/error.js e global-error.js, + onRequestError em instrumentation.js
# pra erro do lado servidor). Sem NEXT_PUBLIC_SENTRY_DSN, o Sentry nunca
# inicializa em lugar nenhum — zero requisição de rede, zero mudança de
# comportamento (ver o guarda em instrumentation-client.js/sentry.*.config.js).
# 1. Crie um projeto Next.js em https://sentry.io (conta própria — este app
#    não cria isso por você)
# 2. Settings do projeto -> Client Keys (DSN) -> copie a DSN
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oNNNN.ingest.us.sentry.io/NNNN
#
# (OPCIONAL, dentro do opcional) Upload de source maps no build, pra stack
# trace legível no Sentry em vez de código minificado. Requer as 3 —
# faltando qualquer uma, o build local funciona normal e só pula o upload.
# SENTRY_ORG=sua-org
# SENTRY_PROJECT=seu-projeto
# SENTRY_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────
# (OPCIONAL) Feature flags — liga/desliga uma funcionalidade sem mexer em
# código (ver src/lib/feature-flags.ts). Ausente ou qualquer valor != "true"
# = desligado (fail-closed). Pra ligar em produção: adicione a variável no
# Vercel (Project Settings -> Environment Variables) com o valor "true" e
# faça um redeploy.
# FEATURE_OUTLIER_DETECTION=true
# FEATURE_K8S_DBM_COVERAGE=true

